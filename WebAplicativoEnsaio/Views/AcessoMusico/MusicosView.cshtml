@model IEnumerable<WebAplicativoEnsaio.Models.Ensaio>

<div class="container mt-5" style="max-width: 900px;">
    <h1 class="text-center mb-4" style="font-size: 2.5rem; font-weight: bold; color: black;">
        🎵 Músicas Disponíveis por Data 🎵
    </h1>

    <!-- Botão para sair -->
    <div class="text-end mb-4">
        <a asp-controller="Account" asp-action="Login" class="btn btn-danger btn-lg">
            <i class="bi bi-box-arrow-right"></i> Sair
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var ensaio in Model)
        {
            <div class="card my-4 shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">📅 Data do Culto: @ensaio.Date.ToString("dd/MM/yyyy")</h4>
                    <h5 class="mb-0">👥 Grupo Selecionado: @ensaio.GrupoSelecionado</h5>
                </div>
                <div class="card-body">
                    <!-- Músicos Escalados -->
                    @if (ensaio.Musicos != null && ensaio.Musicos.Any())
                    {
                        <div class="mt-3">
                            <h6 class="mb-3" style="font-weight: bold;">🎵 Músicos Escalados:</h6>
                            <div class="row">
                                @foreach (var musico in ensaio.Musicos.Where(m => m.Grupo == ensaio.GrupoSelecionado))
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="card border-secondary shadow-sm">
                                            <div class="card-body bg-light">
                                                <h5 class="card-title text-dark" style="font-weight: bold;">🎤 @musico.Nome</h5>
                                                <p class="card-text text-muted">Grupo: <span class="text-dark">@musico.Grupo</span></p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mt-2">Nenhum músico cadastrado para este ensaio.</p>
                    }

                    <!-- Repertório -->
                    @if (ensaio.Musics != null && ensaio.Musics.Any())
                    {
                        <h6 class="mt-4 mb-2" style="font-weight: bold;">📋 Repertório:</h6>
                        <table class="table table-hover table-bordered shadow-sm rounded">
                            <thead class="bg-light">
                                <tr>
                                    <th style="color: black;">Título</th>
                                    <th style="color: black;">Observações</th>
                                    <th style="color: black;">Link do YouTube</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var music in ensaio.Musics)
                                {
                                    <tr>
                                        <td style="color: black; font-weight: bold;">🎵 @music.Title</td>
                                        <td style="color: black;">@music.Notes</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(music.YouTubeLink))
                                            {
                                                <a href="@music.YouTubeLink" target="_blank" class="btn btn-outline-primary btn-sm">
                                                    <i class="bi bi-play-circle"></i> Acessar
                                                </a>
                                            }
                                            else
                                            {
                                                <span style="color: black;">Não disponível</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">Nenhuma música cadastrada para este ensaio.</p>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center mt-4" role="alert">
            <i class="bi bi-exclamation-circle"></i> Nenhuma música disponível no momento.
        </div>
    }
</div>
