@model WebAplicativoEnsaio.Models.Ensaio

@{
    ViewData["Title"] = "Criar Ensaio";
}

<h1 class="my-4">Criar Ensaio</h1>

<form asp-action="Create" method="post">
    <h3>Selecione o Grupo e Musicas</h3>
    
    <div class="form-check">
        <input type="radio" class="form-check-input" id="grupoA" name="grupoSelecionado" value="Grupo A" />
        <label class="form-check-label" for="grupoA">Grupo A</label>
    </div>
    <div class="form-check">
        <input type="radio" class="form-check-input" id="grupoB" name="grupoSelecionado" value="Grupo B" />
        <label class="form-check-label" for="grupoB">Grupo B</label>
    </div>
    <div class="form-group mb-3">
        <label for="Date">Data do Ensaio</label>
        <input type="date" class="form-control" id="Date" name="Date" required />
    </div>
    <div class="form-group mb-3">
        <label for="Description">Descrição</label>
        <textarea class="form-control" id="Description" name="Description" rows="3"></textarea>
    </div>
    <div class="form-group mb-3">
        <label for="Musics">Selecione Músicas</label>
        <div id="Musics">
            @foreach (var music in ViewBag.Musics as IEnumerable<WebAplicativoEnsaio.Models.Musics>)
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="Music_@music.Id" name="selectedMusicIds" value="@music.Id" />
                    <label class="form-check-label" for="Music_@music.Id">@music.Title</label>
                </div>
            }
        </div>
    </div>
   
    <button type="submit" class="btn btn-success">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
