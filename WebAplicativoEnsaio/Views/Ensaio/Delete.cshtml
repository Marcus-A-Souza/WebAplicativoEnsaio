@model WebAplicativoEnsaio.Models.Ensaio

@{
    ViewData["Title"] = "Excluir Ensaio";
}

<h1>Excluir Ensaio</h1>

<div class="alert alert-warning">
    Tem certeza de que deseja excluir este ensaio?
</div>

<table class="table table-bordered">
    <tr>
        <th>Data</th>
        <td>@Model.Date.ToString("dd/MM/yyyy")</td>
    </tr>
    <tr>
        <th>Descrição</th>
        <td>@Model.Description</td>
    </tr>
    <tr>
        <th>Músicas</th>
        <td>
            <ul>
                @if (Model.Musics != null)
                {
                    @foreach (var music in Model.Musics)
                    {
                        <li>@music.Title</li>
                    }
                }
                else
                {
                    <li>Nenhuma música associada</li>
                }
            </ul>
        </td>
    </tr>
</table>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="List" class="btn btn-secondary">Cancelar</a>
</form>

