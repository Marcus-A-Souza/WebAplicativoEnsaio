@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/homepage.css" rel="stylesheet" asp-append-version="true">
</head>
<body>
    <header class="bg-dark text-white text-center py-5">
        <div class="container">
            <!-- Logo -->
            <div>
                <img src="~/images/logofarol.jpeg" alt="Logo" style="max-width: 120px;" />
            </div>
            <p class="lead">Gerencie músicas e ensaios de forma simples e eficiente.</p>

            <!-- Botões de navegação -->
            <a asp-controller="Musics" asp-action="Index" class="btn btn-primary btn-lg me-2">Músicas</a>
            <a asp-controller="Ensaio" asp-action="Index" class="btn btn-outline-light btn-lg me-2">Ensaios</a>
            <a asp-controller="Musicos" asp-action="Index" class="btn btn-outline-light btn-lg me-2">
                <i class="bi bi-person-plus"></i> Musicos
            </a>

            <!-- Botão de saída estilizado -->
            <a asp-controller="Account" asp-action="Login" class="btn btn-danger btn-lg">
                <i class="bi bi-box-arrow-right"></i> Sair
            </a>
        </div>
    </header>

    <section class="features py-5 text-center">
        <div class="container">
            <h2 class="mb-4">Funcionalidades</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="feature-box p-4 shadow-sm rounded">
                        <i class="bi bi-music-note-beamed display-3 text-primary"></i>
                        <h4 class="mt-3">Gerenciamento de Músicas</h4>
                        <p>Adicione, edite e organize suas músicas favoritas para ensaios.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-box p-4 shadow-sm rounded">
                        <i class="bi bi-calendar-check display-3 text-success"></i>
                        <h4 class="mt-3">Agenda de Ensaios</h4>
                        <p>Programe os ensaios e compartilhe com todos os membros do grupo.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-box p-4 shadow-sm rounded">
                        <i class="bi bi-chat-dots display-3 text-warning"></i>
                        <h4 class="mt-3">Notificações por WhatsApp</h4>
                        <p>Mantenha todos atualizados com notificações rápidas e automáticas.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer class="bg-dark text-white text-center py-4">
        <p>&copy; 2025 WebAplicativoEnsaio. Todos os direitos reservados.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
