@model WebAplicativoEnsaio.Models.Musics

@{
    ViewData["Title"] = "Editar Música";
}

<h1>Editar Música</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group mb-3">
        <label for="Title">Título</label>
        <input type="text" class="form-control" id="Title" asp-for="Title" required />
    </div>
    <div class="form-group mb-3">
        <label for="Notes">Observações</label>
        <textarea class="form-control" id="Notes" asp-for="Notes"></textarea>
    </div>
    <div class="form-group mb-3">
        <label for="YouTubeLink">Link do YouTube</label>
        <input type="url" class="form-control" id="YouTubeLink" asp-for="YouTubeLink" required />
    </div>
    <button type="submit" class="btn btn-success">Salvar Alterações</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
